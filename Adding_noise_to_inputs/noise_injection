<script>

const weightSlider = document.getElementById("weight");
const sigmaSlider = document.getElementById("sigma");
const targetSlider = document.getElementById("target");

const weightValue = document.getElementById("wValue");
const sigmaValue = document.getElementById("sigmaValue");
const targetValue = document.getElementById("targetValue");

const empiricalLoss =
    document.getElementById("empiricalLoss");

const modelLine =
    document.getElementById("modelLine");

const cleanPoint =
    document.getElementById("cleanPoint");

const samples =
    document.getElementById("samples");

const playButton =
    document.getElementById("playButton");

const resetButton =
    document.getElementById("resetButton");


let numberOfSamples = 0;
let playing = false;
let animationFrame = null;


/* --------------------------------
   Gaussian random number
-------------------------------- */

function gaussianRandom() {

    let u = 0;
    let v = 0;

    while (u === 0) {
        u = Math.random();
    }

    while (v === 0) {
        v = Math.random();
    }

    return Math.sqrt(
        -2 * Math.log(u)
    ) *
    Math.cos(
        2 * Math.PI * v
    );
}


/* --------------------------------
   Coordinate transformation
-------------------------------- */

function xToPixel(x) {

    return 70 + ((x + 2) / 4) * 610;

}


function yToPixel(y) {

    return 360 -
           ((y + 2.5) / 5) * 320;

}


/* --------------------------------
   Draw visualization
-------------------------------- */

function render() {

    const w =
        parseFloat(weightSlider.value);

    const sigma =
        parseFloat(sigmaSlider.value);

    const target =
        parseFloat(targetSlider.value);


    weightValue.textContent =
        w.toFixed(2);

    sigmaValue.textContent =
        sigma.toFixed(2);

    targetValue.textContent =
        target.toFixed(2);


    /*
       Model y = wx
    */

    modelLine.setAttribute(
        "x1",
        xToPixel(-2)
    );

    modelLine.setAttribute(
        "y1",
        yToPixel(w * (-2))
    );

    modelLine.setAttribute(
        "x2",
        xToPixel(2)
    );

    modelLine.setAttribute(
        "y2",
        yToPixel(w * 2)
    );


    /*
       Clean input

       We use x = 0.75
    */

    const cleanX = 0.75;

    const cleanPrediction =
        w * cleanX;


    cleanPoint.setAttribute(
        "cx",
        xToPixel(cleanX)
    );

    cleanPoint.setAttribute(
        "cy",
        yToPixel(cleanPrediction)
    );


    /*
       Draw noisy samples
    */

    samples.innerHTML = "";

    let totalLoss = 0;


    for (
        let i = 0;
        i < numberOfSamples;
        i++
    ) {

        const noise =
            gaussianRandom() * sigma;

        const noisyX =
            cleanX + noise;

        const prediction =
            w * noisyX;


        const loss =
            Math.pow(
                target - prediction,
                2
            );


        totalLoss += loss;


        /*
           Noise line
        */

        const noiseLine =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "line"
            );


        noiseLine.setAttribute(
            "x1",
            xToPixel(cleanX)
        );

        noiseLine.setAttribute(
            "y1",
            yToPixel(cleanPrediction)
        );

        noiseLine.setAttribute(
            "x2",
            xToPixel(noisyX)
        );

        noiseLine.setAttribute(
            "y2",
            yToPixel(prediction)
        );

        noiseLine.setAttribute(
            "class",
            "noise-line"
        );


        samples.appendChild(
            noiseLine
        );


        /*
           Noisy point
        */

        const point =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "circle"
            );


        point.setAttribute(
            "cx",
            xToPixel(noisyX)
        );

        point.setAttribute(
            "cy",
            yToPixel(prediction)
        );

        point.setAttribute(
            "r",
            4
        );

        point.setAttribute(
            "class",
            "noisy-point"
        );


        samples.appendChild(
            point
        );

    }


    /*
       Expected loss

       E[(y-w(x+ε))²]

       = (y-wx)² + σ²w²
    */

    const cleanLoss =
        Math.pow(
            target - w * cleanX,
            2
        );


    const expectedLoss =
        cleanLoss +
        sigma * sigma * w * w;


    if (numberOfSamples > 0) {

        empiricalLoss.textContent =
            (
                totalLoss /
                numberOfSamples
            ).toFixed(3);

    }
    else {

        empiricalLoss.textContent =
            expectedLoss.toFixed(3);

    }

}


/* --------------------------------
   Animation
-------------------------------- */

function animate() {

    if (!playing) {
        return;
    }


    numberOfSamples += 3;


    /*
       Limit number of samples
       so the browser remains responsive.
    */

    if (numberOfSamples > 180) {

        numberOfSamples = 180;

    }


    render();


    if (numberOfSamples < 180) {

        animationFrame =
            requestAnimationFrame(
                animate
            );

    }
    else {

        playing = false;

        playButton.textContent =
            "▶ Play";

    }

}


/* --------------------------------
   Play / Pause
-------------------------------- */

playButton.addEventListener(
    "click",
    function () {

        if (playing) {

            playing = false;

            playButton.textContent =
                "▶ Play";


            if (animationFrame) {

                cancelAnimationFrame(
                    animationFrame
                );

            }

        }
        else {

            playing = true;

            playButton.textContent =
                "Ⅱ Pause";

            animate();

        }

    }
);


/* --------------------------------
   Reset
-------------------------------- */

resetButton.addEventListener(
    "click",
    function () {

        playing = false;

        numberOfSamples = 0;

        playButton.textContent =
            "▶ Play";


        if (animationFrame) {

            cancelAnimationFrame(
                animationFrame
            );

        }


        weightSlider.value = 1.5;
        sigmaSlider.value = 0.5;
        targetSlider.value = 1;


        render();

    }
);


/* --------------------------------
   Slider interaction
-------------------------------- */

weightSlider.addEventListener(
    "input",
    function () {

        numberOfSamples = 0;

        render();

    }
);


sigmaSlider.addEventListener(
    "input",
    function () {

        numberOfSamples = 0;

        render();

    }
);


targetSlider.addEventListener(
    "input",
    function () {

        numberOfSamples = 0;

        render();

    }
);


/* --------------------------------
   Initial rendering
-------------------------------- */

render();

</script>

</body>
</html>
"""


